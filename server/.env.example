# API server. Copy to server/.env; `bun dev` loads it with node --env-file.
# Every value below is the default, so the file is optional for local work.

# local | test | staging | production
ENVIRONMENT=local
PORT=3001
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000

# Postgres from docker-compose.yml.
DATABASE_URL=postgres://xors:xors@localhost:5432/xors

# OpenTelemetry. Locally, grafana/otel-lgtm from docker-compose.yml.
OTEL_SERVICE_NAME=xors-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Set to true to run without telemetry.
OTEL_SDK_DISABLED=false
