{
	"name": "www-starter",
	"description": "A Next.js website starter for XORS projects with Foundry integration.",
	"version": "1.0.0",
	"private": true,
	"workspaces": ["website", "contracts"],
	"scripts": {
		"dev": "bun run --filter @xors/website dev",
		"turbo": "bun run --filter @xors/website turbo",
		"chain": "cd contracts && anvil",
		"build": "bun run --filter @xors/contracts build && bun run --filter @xors/website build",
		"build:website": "bun run --filter @xors/website build",
		"build:contracts": "bun run --filter @xors/contracts build",
		"deploy": "bun run --filter @xors/contracts deploy:local",
		"deploy:generate": "bun run --filter @xors/contracts deploy:generate",
		"generate": "bun run --filter @xors/contracts generate",
		"test": "bun run --filter @xors/website test",
		"test:contracts": "bun run --filter @xors/contracts test",
		"type-check": "bun run --filter @xors/website type-check",
		"lint": "bun run --filter @xors/website lint",
		"lint:fix": "bun run --filter @xors/website lint:fix",
		"format": "bun run --filter @xors/website format",
		"format:fix": "bun run --filter @xors/website format:fix",
		"build-icons": "bun run --filter @xors/website build-icons",
		"start": "bun run --filter @xors/website start",
		"clean": "rm -rf node_modules website/node_modules contracts/node_modules"
	}
}
