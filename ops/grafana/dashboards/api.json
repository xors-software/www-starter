{
	"uid": "app-api",
	"title": "API overview",
	"tags": ["api"],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"refresh": "10s",
	"time": {
		"from": "now-30m",
		"to": "now"
	},
	"templating": {
		"list": [
			{
				"name": "service",
				"label": "Service",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "prometheus"
				},
				"query": {
					"query": "label_values(app_http_request_duration_seconds_count, job)",
					"refId": "service"
				},
				"definition": "label_values(app_http_request_duration_seconds_count, job)",
				"refresh": 2,
				"includeAll": true,
				"multi": true,
				"allValue": ".+",
				"current": {
					"text": "All",
					"value": "$__all"
				}
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "row",
			"title": "HTTP (RED, by route template)",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 0,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 2,
			"type": "timeseries",
			"title": "Requests / s",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 1,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "reqps"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (http_route) (rate(app_http_request_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
					"legendFormat": "{{http_route}}"
				}
			]
		},
		{
			"id": 3,
			"type": "timeseries",
			"title": "5xx ratio",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 1,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum(rate(app_http_request_duration_seconds_count{job=~\"$service\",http_response_status_code=~\"5..\"}[$__rate_interval])) / sum(rate(app_http_request_duration_seconds_count{job=~\"$service\"}[$__rate_interval]))",
					"legendFormat": "5xx"
				}
			]
		},
		{
			"id": 4,
			"type": "timeseries",
			"title": "p95 latency",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 16,
				"y": 1,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "s"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(app_http_request_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
					"legendFormat": "{{http_route}}"
				}
			]
		},
		{
			"id": 5,
			"type": "row",
			"title": "Database",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 9,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "Query p95",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "s"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_operation_duration_seconds_bucket{job=~\"$service\"}[$__rate_interval])))",
					"legendFormat": "p95"
				}
			]
		},
		{
			"id": 7,
			"type": "timeseries",
			"title": "Pool connections",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 12,
				"y": 10,
				"w": 12,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum by (state) (app_db_pool_connections{job=~\"$service\"})",
					"legendFormat": "{{state}}"
				}
			]
		},
		{
			"id": 8,
			"type": "row",
			"title": "Node.js runtime",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 18,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 9,
			"type": "timeseries",
			"title": "Event loop delay p99",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 0,
				"y": 19,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "s"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "max(nodejs_eventloop_delay_p99_seconds{job=~\"$service\"})",
					"legendFormat": "p99"
				}
			]
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Event loop utilization",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 8,
				"y": 19,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "max(nodejs_eventloop_utilization_ratio{job=~\"$service\"})",
					"legendFormat": "utilization"
				}
			]
		},
		{
			"id": 11,
			"type": "timeseries",
			"title": "Heap used",
			"datasource": {
				"type": "prometheus",
				"uid": "prometheus"
			},
			"gridPos": {
				"x": 16,
				"y": 19,
				"w": 8,
				"h": 8
			},
			"fieldConfig": {
				"defaults": {
					"unit": "bytes"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom"
				},
				"tooltip": {
					"mode": "multi"
				}
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"expr": "sum(v8js_memory_heap_used_bytes{job=~\"$service\"})",
					"legendFormat": "heap"
				}
			]
		},
		{
			"id": 12,
			"type": "row",
			"title": "Logs (each line links to its trace)",
			"collapsed": false,
			"gridPos": {
				"x": 0,
				"y": 27,
				"w": 24,
				"h": 1
			},
			"panels": []
		},
		{
			"id": 13,
			"type": "logs",
			"title": "Logs",
			"datasource": {
				"type": "loki",
				"uid": "loki"
			},
			"gridPos": {
				"x": 0,
				"y": 28,
				"w": 24,
				"h": 10
			},
			"options": {
				"showTime": true,
				"wrapLogMessage": true,
				"sortOrder": "Descending",
				"enableLogDetails": true
			},
			"targets": [
				{
					"refId": "A",
					"datasource": {
						"type": "loki",
						"uid": "loki"
					},
					"expr": "{service_name=~\"$service\"}"
				}
			]
		}
	]
}
