{
	"name": "web",
	"description": "Next.js frontend for XORS projects.",
	"version": "1.0.0",
	"private": true,
	"scripts": {
		"dev": "next dev --port 3000",
		"turbo": "next dev --turbopack",
		"build": "next build",
		"build-icons": "svgr --out-dir app/components/icons/generated --icon --replace-attr-values '#fff=currentColor' --typescript icon-svg",
		"clean": "rm -rf node_modules .next",
		"type-check": "tsc --pretty --noEmit",
		"test": "vitest run --pool=forks",
		"test:watch": "vitest --pool=forks",
		"start": "next start",
		"lint": "biome lint .",
		"lint:fix": "biome lint --write --unsafe .",
		"format": "biome format .",
		"format:fix": "biome format --write ."
	},
	"dependencies": {
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-slot": "^1.2.4",
		"@tanstack/react-query": "^5.100.10",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lodash": "^4.18.1",
		"next": "^16.2.6",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"react-use": "^17.6.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@tailwindcss/postcss": "^4.3.0",
		"@svgr/cli": "^8.1.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/react": "^16.3.2",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/jest": "^30.0.0",
		"@types/lodash": "^4.17.24",
		"@types/node": "^25.8.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"autoprefixer": "^10.5.0",
		"jsdom": "^27.4.0",
		"postcss": "^8.5.14",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.9.3",
		"vitest": "^4.1.6"
	}
}
