{
	"name": "www-starter",
	"description": "A Next.js website starter for XORS projects with Foundry integration.",
	"version": "1.0.0",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter @xors/nextjs dev",
		"turbo": "bun run --filter @xors/nextjs turbo",
		"chain": "cd packages/foundry && anvil",
		"build": "bun run --filter @xors/foundry build && bun run --filter @xors/nextjs build",
		"build:nextjs": "bun run --filter @xors/nextjs build",
		"build:foundry": "bun run --filter @xors/foundry build",
		"deploy": "bun run --filter @xors/foundry deploy:local",
		"deploy:generate": "bun run --filter @xors/foundry deploy:generate",
		"generate": "bun run --filter @xors/foundry generate",
		"test": "bun run --filter @xors/nextjs test",
		"test:foundry": "bun run --filter @xors/foundry test",
		"type-check": "bun run --filter @xors/nextjs type-check",
		"lint": "bun run --filter @xors/nextjs lint",
		"lint:fix": "bun run --filter @xors/nextjs lint:fix",
		"format": "bun run --filter @xors/nextjs format",
		"format:fix": "bun run --filter @xors/nextjs format:fix",
		"build-icons": "bun run --filter @xors/nextjs build-icons",
		"start": "bun run --filter @xors/nextjs start",
		"clean": "rm -rf node_modules packages/*/node_modules"
	}
}
