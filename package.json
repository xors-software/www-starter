{
	"name": "xors-starter",
	"description": "A full-stack monorepo starter with a Next.js frontend and a Hono backend on Node 24.",
	"version": "1.0.0",
	"private": true,
	"packageManager": "bun@1.3.14",
	"workspaces": [
		"web",
		"server"
	],
	"scripts": {
		"dev": "bun run --parallel --filter '*' dev",
		"dev:web": "bun run --filter web dev",
		"dev:server": "bun run --filter server dev",
		"build": "bun run --filter web build",
		"start": "bun run --parallel --filter '*' start",
		"test": "bun run --filter '*' test",
		"lint": "bun run --filter '*' lint",
		"lint:fix": "bun run --filter '*' lint:fix",
		"format": "bun run --filter '*' format",
		"format:fix": "bun run --filter '*' format:fix",
		"type-check": "bun run --filter '*' type-check",
		"check": "biome ci . && bun run type-check && bun run test",
		"infra:up": "docker compose up -d --wait",
		"infra:down": "docker compose down",
		"db:migrate": "bun run --filter server db:migrate",
		"clean": "rm -rf node_modules web/node_modules server/node_modules web/.next"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8"
	}
}
